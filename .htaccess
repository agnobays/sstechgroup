# ==============================================================================
# S&S Tech Group (Pty) Ltd - DirectAdmin / Apache Routing & Passenger Handler
# ==============================================================================

<IfModule mod_passenger.c>
  PassengerEnabled on
  PassengerAppType node
  PassengerStartupFile app.js
  PassengerNodejs /home/sstechgr/nodevenv/domains/sstechgroup.co.za/public_html/18/bin/node
</IfModule>

# Prevent Apache from directly serving uncompiled dev index.html
DirectoryIndex disabled

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always enforce HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow direct access to compiled assets and public files if they exist in dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/ -f
  RewriteRule ^(.*)$ dist/ [L]

  # For everything else, pass to Express / Phusion Passenger app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ app.js [QSA,L]
</IfModule>
