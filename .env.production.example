# ==============================================================================
# S&S Tech Group (Pty) Ltd - Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Security - IMPORTANT: Replace this secret key with a strong 64+ character random string!
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_for_production
JWT_EXPIRES_IN=24h

# SQLite Database Location (relative to deployment root or absolute path)
DATABASE_PATH=./data/sstechgroup.sqlite
# Set to true on systems with older GLIBC (like CloudLinux / CentOS / DirectAdmin) to use zero-dependency WebAssembly SQLite
USE_WASM_SQLITE=true

# Client Domain / Canonical Origin (used for CORS and redirect headers)
CLIENT_URL=https://sstechgroup.co.za

# ------------------------------------------------------------------------------
# SMTP Email Dispatching Configuration (Optional)
# If configured, quotes, invoices, and enquiries will send directly via SMTP.
# If omitted, test transport / preview tokens will be logged safely.
# ------------------------------------------------------------------------------
SMTP_HOST=mail.sstechgroup.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@sstechgroup.co.za
SMTP_PASS=mMfZKH3vanytTmUhFhQn
EMAIL_FROM="S&S Tech Group (Pty) Ltd" <info@sstechgroup.co.za>
